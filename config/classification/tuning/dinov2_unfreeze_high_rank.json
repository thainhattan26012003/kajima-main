{
  "model": {
    "method": "tuning",
    "model_name": "dinov2_base",
    "model_path": "checkpoints/dinov2-base",
    "peft_adapter_path": "checkpoints/dinov2-unfreeze-high-rank",
    "classifier_head": "linear"
  },
  "training": {
    "batch_size": 16,
    "criterion_type": "CE",
    "weight": [1.0, 1.0, 1.0, 1.0],
    "init_head": "no",
    "lora_initialization_strategy": "random",
    "lora_rank": 64,
    "lora_alpha": 128,
    "lr": 0.00005,
    "micro_batch_size": 16,
    "num_epochs": 50,
    "num_workers": 4,
    "optimizer": "adamw",
    "print_freq": 1,
    "sampler": "random_sampler",
    "seed": 42,
    "weight_decay": 0.05
  },
  "testing": {
    "batch_size": 16
  },
  "inference": {
    "crop_size": 518,
    "resolution": 518
  },
  "data": {
    "train_dataset_dir": "datasets/kajima_dataset",
    "test_dataset_dir": "datasets/kajima_test_dataset",
    "num_classes": 4
  }
}
