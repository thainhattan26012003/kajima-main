{
  "model": {
    "method": "tuning",
    "model_name": "dinov2_base",
    "model_path": "checkpoints/dinov2-base",
    "peft_adapter_path": "checkpoints/dinov2-option-b-optimize-v2",
    "classifier_head": "linear"
  },
  "training": {
    "batch_size": 128,
    "criterion_type": "CE",
    "init_head": "no",
    "lora_initialization_strategy": "random",
    "lora_rank": 16,
    "lr": 0.0001,
    "micro_batch_size": 32,
    "num_epochs": 40,
    "num_layer_finetuned": 4,
    "num_workers": 2,
    "optimizer": "adamw",
    "print_freq": 1,
    "sampler": "random_sampler",
    "seed": 42,
    "weight_decay": 0.05
  },
  "testing": { "batch_size": 6 },
  "inference": { "crop_size": 448, "resolution": 448 },
  "data": {
    "train_dataset_dir": "datasets/kajima_dataset",
    "test_dataset_dir": "datasets/kajima_test_dataset",
    "num_classes": 4
  }
}
