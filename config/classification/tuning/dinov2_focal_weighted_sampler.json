{
  "model": {
    "method": "tuning",
    "model_name": "dinov2_base",
    "model_path": "checkpoints/dinov2-base",
    "peft_adapter_path": "checkpoints/dinov2-option-c",
    "classifier_head": "linear"
  },
  "training": {
    "batch_size": 16,
    "criterion_type": "focal",
    "weight": [1.0, 4.0, 1.0, 6.0],
    "init_head": "class_mean",
    "lora_initialization_strategy": "random",
    "lora_rank": 16,
    "lora_alpha": 32,
    "lr": 2e-5,
    "micro_batch_size": 16,
    "num_epochs": 40,
    "num_workers": 4,
    "optimizer": "adamw",
    "print_freq": 1,
    "sampler": "weighted_sampler",
    "seed": 42,
    "weight_decay": 0.1
  },
  "testing": {
    "batch_size": 16
  },
  "inference": {
    "crop_size": 448,
    "resolution": 448
  },
  "data": {
    "train_dataset_dir": "datasets/kajima_dataset",
    "test_dataset_dir": "datasets/kajima_test_dataset",
    "num_classes": 4
  }
}
