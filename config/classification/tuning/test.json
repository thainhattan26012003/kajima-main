{
    "model": {
      "method": "tuning",
      "model_name": "dinov2_base",
      "model_path": "checkpoints/dinov2-base",
      "peft_adapter_path": "checkpoints/dinov2-option-a",
      "classifier_head": "cosine"
    },
    "training": {
      "batch_size": 8,
      "criterion_type": "CE",
      "init_head": "class_mean",
      "lora_initialization_strategy": "random",
      "lora_rank": 32,
      "lr": 0.0001,
      "micro_batch_size": 32,
      "num_epochs": 20,
      "num_layer_finetuned": 8,
      "num_workers": 2,
      "optimizer": "adam",
      "sampler": "random_sampler",
      "seed": 32
    },
    "testing": { "batch_size": 16 },
    "inference": { "crop_size": 518, "resolution": 518 },
    "data": {
      "train_dataset_dir": "datasets/kajima_dataset",
      "test_dataset_dir": "datasets/kajima_test_dataset",
      "num_classes": 4
    }
  }
  