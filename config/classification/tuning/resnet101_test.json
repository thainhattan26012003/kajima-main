{
  "model": {
    "method": "tuning",
    "model_name": "resnet101",
    "model_path": "checkpoints/resnet101",
    "peft_adapter_path": "checkpoints/resnet101-run",
    "classifier_head": "cosine"
  },
  "training": {
    "batch_size": 8,
    "criterion_type": "CE",
    "init_head": "class_mean",
    "lora_initialization_strategy": "random",
    "lora_rank": 16,
    "lr": 0.0001,
    "micro_batch_size": 8,
    "early_stop_patience": 20,
    "num_epochs": 100,
    "num_workers": 2,
    "optimizer": "adam",
    "sampler": "random_sampler",
    "seed": 32
  },
  "testing": {
    "batch_size": 16
  },
  "inference": {
    "crop_size": 224,
    "resolution": 224
  },
  "data": {
    "train_dataset_dir": "datasets/kajima_dataset",
    "test_dataset_dir": "datasets/kajima_test_dataset",
    "num_classes": 4
  }
}
